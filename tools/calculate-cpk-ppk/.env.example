# =============================================================================
# Variables of this tool. Copy to `.env` for local runs; in Railway set them in
# the project's Variables tab. `.env` is never committed.
# Adapted from the platform template plantillas/integracion/sso/env-tool.example
# =============================================================================

# Local default only. Railway injects its own PORT — do NOT set it there.
# Matches `localPort` of this tool in the core's deployments.json.
PORT=8108

# Where the compiled SPA lives. The Docker image sets it to /app/web/dist.
# Empty = API only (GET / answers a JSON pointer instead of the UI).
UI_DIST_DIR=./web/dist

# -- ORCA core (MACHINE plane) ------------------------------------------------
# With or without /api/v1. The key needs scopes events:read AND events:write.
# Server-to-server only: this key never reaches the browser.
ISOTOOLS_API_URL=https://isotools-production.up.railway.app/api/v1
ISOTOOLS_API_KEY=

# shadow = compute and store, never send (default, and the safe value until the
#          core's deployments.json declares this tool's subdomain).
# live   = publish results to the core. Flip it in the SAME change that
#          registers the subdomain — see docs/DESPLIEGUE.md §5.
CORE_PUBLISH=shadow

# Subscription poll. Every 5 s by default; never starts at since_seq=0.
POLL_ENABLED=true
POLL_INTERVAL_MS=5000

# Postgres. Empty = memory only (studies and cursor lost on restart).
# In Railway, attaching a Postgres to the project injects it.
DATABASE_URL=

# Key with which OTHER services call this tool's /api (x-api-key). Leave EMPTY
# while OIDC is not configured: with this set and no OIDC_ISSUER, people in a
# browser can no longer use the UI (only services can authenticate).
TOOL_API_KEY=

# =============================================================================
# SINGLE SIGN-ON (HUMAN plane). Activated by the PRESENCE of OIDC_ISSUER.
# Set but incomplete -> the process refuses to start (half-configured auth looks
# protected and isn't). The first three come from the platform team.
# =============================================================================
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Must match EXACTLY the URI allowed in the IdP. Ask for BOTH from day one:
#   production: https://ccp.orcalabs.mx/auth/callback
#   local:      http://localhost:8108/auth/callback
OIDC_REDIRECT_URI=http://localhost:8108/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=
OIDC_SCOPES=openid profile email roles
OIDC_ROLES_CLAIM=roles
# Platform role -> this tool's role. Empty uses src/platform/auth/role-mapping.js
ROLE_MAP=

# openssl rand -hex 32 — one per tool, never shared between tools.
SESSION_SECRET=
SESSION_COOKIE_NAME=ccp_session
SESSION_TTL_SECONDS=28800
# true ONLY for local plain HTTP.
SESSION_INSECURE_COOKIES=false
