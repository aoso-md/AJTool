{
  "name": "run-msa-analysis",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "run_msa_analysis — federated tool of the ORCA platform. Consumes NEW_DEVICE_REGISTERED by poll, publishes MSA_VALIDATED. Backend only: the frontend lives in web/ with its own toolchain.",
  "main": "src/server.js",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "web:install": "cd web && pnpm install --frozen-lockfile",
    "web:dev": "cd web && pnpm run dev",
    "web:build": "cd web && pnpm run build"
  },
  "dependencies": {
    "express": "^5.2.1",
    "openid-client": "^6.8.4",
    "pg": "^8.18.0"
  },
  "devDependencies": {
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1"
  }
}
