# From the platform template (plantillas/integracion/docker/dockerignore.example).

# `**/` is mandatory: without it only the root node_modules is excluded and the
# one in web/ is copied into the image (pnpm's symlink farm = broken imports).
**/node_modules

# Images build from source, never from a dist/ left on a laptop.
dist
**/dist
coverage

.git
.env
.env.*
!.env.example
npm-debug.log*
*.log

# Not input of any build.
*.md
docker-compose*.yml
archive
docs
db

# Do NOT add tools/*/web, tools/*/src or the lockfiles: they ARE build input.
