NODE_ENV=production
AJTOOL_ENVIRONMENT=staging
DATABASE_REQUIRED=true
# El operador provisiona una base exclusiva con rol runtime, nunca owner/admin.
DATABASE_URL=
CORE_PUBLISH=shadow
POLL_ENABLED=false
ISOTOOLS_API_URL=
ISOTOOLS_API_KEY=
TOOL_API_KEY=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://ccp.orcalabs.mx/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=
OIDC_SCOPES=openid
OIDC_ROLES_CLAIM=roles
ROLE_MAP=
SESSION_SECRET=
SESSION_COOKIE_NAME=ccp_session
SESSION_INSECURE_COOKIES=false
