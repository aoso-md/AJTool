# Prepared only. Operator supplies a verified PostgreSQL runtime URL privately.
# Never paste it in chat; never use a Supabase anon/service_role API key as DB login.
NODE_ENV=production
AJTOOL_ENVIRONMENT=production
DATABASE_REQUIRED=true
DATABASE_URL=
NODE_EXTRA_CA_CERTS=/app/certs/supabase-prod-ca-2021.crt
CORE_PUBLISH=shadow
# Keep polling stopped until approved cursor/history disposition is implemented.
POLL_ENABLED=false
ISOTOOLS_API_URL=
ISOTOOLS_API_KEY=
OIDC_ISSUER=
OIDC_REDIRECT_URI=https://ccp.orcalabs.mx/auth/callback
# No changes to existing machine credentials are implied by this template.
