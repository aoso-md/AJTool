{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "MSA_VALIDATED",
  "title": "MSA_VALIDATED",
  "type": "object",
  "required": ["type", "payload"],
  "properties": {
    "type": { "const": "MSA_VALIDATED" },
    "source": { "type": "string" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "payload": {
      "type": "object",
      "required": ["studyId", "deviceId", "gageRRPercent", "ndc"],
      "properties": {
        "studyId": { "type": "string" },
        "deviceId": { "type": "string" },
        "gageRRPercent": { "type": "number" },
        "ndc": { "type": "integer" },
        "recommendation": { "type": "string" }
      }
    }
  }
}

