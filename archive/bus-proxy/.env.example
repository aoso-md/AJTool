# Copy this file to ".env" in this same folder (bus-proxy/.env) and fill in
# the real values [EXTERNAL_ADMIN] gives you. bus-proxy/.env is gitignored — it will
# never be committed. Never paste real values into this .env.example file.

# Base URL of [EXTERNAL_ADMIN]' real IsoTools event broker API, no trailing slash.
# Example shape (NOT a real value): https://isotools.example.com/api/v2
ISOTOOLS_API_BASE_URL=

# API key [EXTERNAL_ADMIN] issues you, used when THIS proxy calls OUT to his API.
# Sent as the "x-api-key" header, server-side only — the proxy never
# sends this to the browser.
ISOTOOLS_API_KEY=

# The key [EXTERNAL_ADMIN]' platform must send when IT calls INTO this proxy
# (POST /events, GET /events/subscriptions/:toolId, GET /events/chain/:id)
# as the "x-api-key" header. Leave empty during local dev/demo — those
# routes stay open. Set this once [EXTERNAL_ADMIN]' platform is actually calling
# in, so random internet traffic can't post fake events.
INBOUND_API_KEY=

# Port the local proxy listens on. 8787 by default, change only if it
# collides with something else on your machine.
PORT=8787
